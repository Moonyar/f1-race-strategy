data/
# Pickled sklearn pipelines - regenerate with python src/models.py
models/

# figures/ is deliberately NOT ignored: README.md embeds
# figures/degradation_curves.png, and the plot is the fastest way for a reader
# to see the result. It is one small PNG, regenerated by src/degradation.py.

.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.streamlit/secrets.toml
